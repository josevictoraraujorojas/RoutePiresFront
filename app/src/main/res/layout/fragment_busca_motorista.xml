<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    tools:context=".BuscaMotoristaFragment">


    <!-- Botão Procurando Corrida -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/procurando_corrida_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="40dp"
        android:background="@drawable/rounded_button_white_border"
        android:padding="16dp"
        android:text="Procurando Corrida..."
        android:textColor="@color/blue"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/swirl_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="whirl"
        android:src="@drawable/buscando_corrida"
        app:layout_constraintBottom_toTopOf="@+id/cancel_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/procurando_corrida_button" />


    <ImageView
        android:id="@+id/search_icon"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="searching"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_search_graph"
        app:layout_constraintBottom_toBottomOf="@+id/swirl_image"
        app:layout_constraintEnd_toEndOf="@+id/swirl_image"
        app:layout_constraintStart_toStartOf="@+id/swirl_image"
        app:layout_constraintTop_toTopOf="@+id/swirl_image" />


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/cancel_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/rounded_button_white_border"
        android:padding="16dp"
        android:text="Cancelar"
        android:textColor="@color/blue"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
