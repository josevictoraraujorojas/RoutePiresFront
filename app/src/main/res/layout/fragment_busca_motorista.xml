<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".ui.passageiro.BuscaMotoristaFragment">

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/procurando_corrida_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="24dp"
        android:background="@drawable/rounded_button_white_border"
        android:padding="16dp"
        android:text="Procurando Corrida..."
        android:textColor="@color/blue"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RelativeLayout
        android:id="@+id/layout_animacoes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center">

        <ImageView
            android:id="@+id/swirl_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="whirl"
            android:src="@drawable/buscando_corrida" />

        <ImageView
            android:id="@+id/search_icon"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_centerInParent="true"
            android:contentDescription="searching"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search_graph" />

    </RelativeLayout>

    <!-- RecyclerView escondido inicialmente -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_mototaxistas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        tools:listitem="@layout/item_mototaxista" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/cancel_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/rounded_button_white_border"
        android:padding="16dp"
        android:text="Cancelar"
        android:textColor="@color/blue"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
