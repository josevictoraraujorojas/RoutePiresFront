<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical|center_horizontal"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvCancelar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:textColor="@color/blue"
                android:textSize="16sp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Corrida"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@android:color/black" />

            <TextView
                android:id="@+id/tvLimpar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limpar"
                android:textColor="@color/blue"
                android:textSize="16sp"
                android:layout_weight="1"
                android:gravity="end" />
        </LinearLayout>

        <!-- Categoria -->
        <TextView
            android:text="Categoria"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupTipoCorrida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/btnCorrida"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:text="CORRIDA"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                app:chipBackgroundColor="@color/chip_yellow_selector"
                android:textColor="@color/chip_text_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/btnFreteSimples"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:text="FRETE SIMPLES"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:layout_marginStart="8dp"
                app:chipBackgroundColor="@color/chip_red_selector"
                android:textColor="@color/chip_text_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/btnFrete"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:text="FRETE"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:layout_marginStart="8dp"
                app:chipBackgroundColor="@color/chip_green_selector"
                android:textColor="@color/chip_text_selector" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Forma de Pagamento -->
        <TextView
            android:text="Forma de Pagamento"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupPagamento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/btnPix"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:text="PIX"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                app:chipBackgroundColor="@color/chip_blue_selector"
                android:textColor="@color/chip_text_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/btnDebito"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:text="DÉBITO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:layout_marginStart="8dp"
                app:chipBackgroundColor="@color/chip_purple_selector"
                android:textColor="@color/chip_text_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/btnCredito"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:text="CRÉDITO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:layout_marginStart="8dp"
                app:chipBackgroundColor="@color/chip_purple_selector"
                android:textColor="@color/chip_text_selector" />

            <com.google.android.material.chip.Chip
                android:id="@+id/btnDinheiro"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:text="DINHEIRO"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:layout_marginStart="8dp"
                app:chipBackgroundColor="@color/chip_green_selector"
                android:textColor="@color/chip_text_selector" />
        </com.google.android.material.chip.ChipGroup>

        <!-- Local início -->
        <TextView
            android:text="Local de Início"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_box"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:src="@drawable/ic_location_red"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvLocalInicio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Obtendo localização..."
                android:textColor="@android:color/black" />
        </LinearLayout>

        <!-- Local de término -->
        <TextView
            android:text="Local de Término"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:textColor="@android:color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/input_box"
            android:padding="12dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:src="@drawable/ic_location_red"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvLocalTermino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escolha o destino"
                android:textColor="@android:color/black" />
        </LinearLayout>

        <!-- Botão -->
        <Button
            android:id="@+id/btnBuscar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Buscar Corrida"
            android:textColor="@android:color/white"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/btn_blue_round" />
    </LinearLayout>
</ScrollView>
