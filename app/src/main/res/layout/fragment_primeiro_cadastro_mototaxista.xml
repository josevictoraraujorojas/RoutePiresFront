<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Nome -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textViewNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome completo"
            android:textSize="12sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="#2F3036"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editNome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Digite seu nome"
            android:textColor="#1F2024"
            android:textColorHint="#8F9098"
            android:background="@drawable/bg_edittext_selector"
            android:paddingHorizontal="12dp"
            android:textSize="16sp"
            android:inputType="textPersonName"
            android:textCursorDrawable="@drawable/custom_cursor"/>
    </LinearLayout>

    <!-- E-mail -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textViewEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-Mail"
            android:textSize="12sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="#2F3036"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="nome@email.com"
            android:textColor="#1F2024"
            android:textColorHint="#8F9098"
            android:background="@drawable/bg_edittext_selector"
            android:paddingHorizontal="12dp"
            android:textSize="16sp"
            android:inputType="textEmailAddress"
            android:textCursorDrawable="@drawable/custom_cursor"/>
    </LinearLayout>

    <!-- Telefone -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textViewTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Número de telefone"
            android:textSize="12sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="#2F3036"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTelefone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="(64) 12345-6789"
            android:textColor="#1F2024"
            android:textColorHint="#8F9098"
            android:background="@drawable/bg_edittext_selector"
            android:paddingHorizontal="12dp"
            android:textSize="16sp"
            android:inputType="phone"
            android:textCursorDrawable="@drawable/custom_cursor"/>
    </LinearLayout>

    <!-- Senha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textViewSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Senha"
            android:textSize="12sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="#2F3036"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editSenha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Crie uma senha"
            android:textColor="#1F2024"
            android:textColorHint="#8F9098"
            android:background="@drawable/bg_edittext_selector"
            android:paddingHorizontal="12dp"
            android:textSize="16sp"
            android:inputType="textPassword"
            android:textCursorDrawable="@drawable/custom_cursor"/>
    </LinearLayout>

    <!-- Confirmação de senha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/editSenhaConfirmacao"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Confirme a senha"
            android:textColor="#1F2024"
            android:textColorHint="#8F9098"
            android:background="@drawable/bg_edittext_selector"
            android:paddingHorizontal="12dp"
            android:textSize="16sp"
            android:inputType="textPassword"
            android:textCursorDrawable="@drawable/custom_cursor"/>
    </LinearLayout>

    <!-- Checkbox Termos corrigido -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <CheckBox
            android:id="@+id/chkTermos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/txtTermosCompletos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Li e concordo com os Termos de uso e a Política de Privacidade"
            android:textColor="@android:color/black"
            android:ellipsize="none"
            android:scrollHorizontally="false"
            android:singleLine="false"/>
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="Continuar"
        android:textColor="#FFFFFF"
        android:background="@drawable/bg_botao_arredondado"
        />


</LinearLayout>
