<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".UI.mototaxista.SegundoCadastroMototaxista">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewCNH"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/inter_bold"
            android:text="Número da CNH"
            android:textColor="#2F3036"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editCNH"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edittext_selector"
            android:hint="Digite sua CNH"
            android:inputType="text"
            android:paddingHorizontal="12dp"
            android:textColor="#1F2024"
            android:textColorHint="#8F9098"
            android:textCursorDrawable="@drawable/custom_cursor"
            android:textSize="16sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewDataValidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/inter_bold"
            android:text="Data de Validade"
            android:textColor="#2F3036"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/editDataValidade"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edittext_selector"
            android:hint="24/10/2025"
            android:inputType="date"
            android:paddingHorizontal="12dp"
            android:textColor="#1F2024"
            android:textColorHint="#8F9098"
            android:textCursorDrawable="@drawable/custom_cursor"
            android:textSize="16sp" />
    </LinearLayout>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="@drawable/bg_botao_arredondado"
        android:text="Validar CNH"
        android:textColor="#FFFFFF" />

</LinearLayout>