<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Toolbar -->
    <LinearLayout
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvTitulo"
                android:text="Procurando corrida"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Conteúdo principal: mapa + container do estado -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Mapa -->
        <fragment
            android:id="@+id/mapFragment"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Container para estados da corrida (fragmentos do nav interno) -->
        <FrameLayout
            android:id="@+id/containerEstadoCorrida"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"/>
    </FrameLayout>

    <!-- BottomSheet/Card corrida -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAguardandoCorrida"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Título -->
            <TextView
                android:id="@+id/tvCorridaTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Corrida"
                android:textSize="20sp"
                android:textColor="#000000"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="20dp" />

            <!-- Label Passageiro -->
            <TextView
                android:id="@+id/tvPassageiroLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASSAGEIRO"
                android:textSize="10sp"
                android:textColor="#9E9E9E"
                android:letterSpacing="0.1"
                android:layout_marginBottom="8dp" />

            <!-- Container Passageiro -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/avatarPassageiro"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_user_avatar"
                    android:contentDescription="Foto do passageiro" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:id="@+id/tvNomePassageiro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Karen Roe"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:fontFamily="sans-serif" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <ImageView
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:src="@drawable/ic_star"
                            android:layout_marginEnd="4dp" />

                        <TextView
                            android:id="@+id/tvAvaliacaoPassageiro"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.8"
                            android:textSize="14sp"
                            android:textColor="#000000" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Botão Iniciar Corrida -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnIniciarCorrida"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Iniciar Corrida"
                android:textColor="#007AFF"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:background="@drawable/btn_outline_blue"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="12dp" />

            <!-- Botão Cancelar Corrida -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelarCorrida"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Cancelar Corrida"
                android:textColor="#FF6B4A"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:background="@drawable/btn_outline_red"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
