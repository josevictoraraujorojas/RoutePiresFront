<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Container principal: cada FragmentContainerView é um NavHost separado -->
    <FrameLayout
        android:id="@+id/nav_host_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/menuInferior"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- NavHost para a aba Corrida (inicial) -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_corrida"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:navGraph="@navigation/nav_corrida"
            app:defaultNavHost="true" />

        <!-- NavHost para a aba Avaliação -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_avaliacao"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:navGraph="@navigation/nav_avaliacao"
            android:visibility="gone"
            app:defaultNavHost="false" />

        <!-- NavHost para a aba Negociação -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_negociacao"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:navGraph="@navigation/nav_negociacao"
            android:visibility="gone"
            app:defaultNavHost="false" />

        <!-- NavHost para a aba Configuração -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/nav_host_configuracao"
            android:name="androidx.navigation.fragment.NavHostFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:navGraph="@navigation/nav_configuracao"
            android:visibility="gone"
            app:defaultNavHost="false" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/menuInferior"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/menu_configuracao_passageiro_bottom_nav" />

</androidx.constraintlayout.widget.ConstraintLayout>
