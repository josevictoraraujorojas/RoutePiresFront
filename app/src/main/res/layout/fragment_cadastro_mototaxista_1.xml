<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textViewNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome completo"
            android:textSize="12sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editNome"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Digite seu nome"
            android:textColor="@android:color/black"
            android:textColorHint="#888888"
            android:background="@drawable/bg_edittext_selector"
            android:paddingHorizontal="12dp"
            android:textSize="16sp"
            android:inputType="textPersonName" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textViewEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="E-Mail"
            android:textSize="12sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editEmail"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="nome@email.com"
            android:textColor="@android:color/black"
            android:textColorHint="#888888"
            android:background="@drawable/bg_edittext_selector"
            android:paddingHorizontal="12dp"
            android:textSize="16sp"
            android:inputType="textEmailAddress" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textViewTelefone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Número de telefone"
            android:textSize="12sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editTelefone"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="(64) 12345-6789"
            android:textColor="@android:color/black"
            android:textColorHint="#888888"
            android:background="@drawable/bg_edittext_selector"
            android:paddingHorizontal="12dp"
            android:textSize="16sp"
            android:inputType="phone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textViewSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Senha"
            android:textSize="12sp"
            android:fontFamily="@font/inter_bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/editSenha"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Crie uma senha"
            android:textColor="@android:color/black"
            android:textColorHint="#888888"
            android:background="@drawable/bg_edittext_selector"
            android:paddingHorizontal="12dp"
            android:textSize="16sp"
            android:inputType="textPassword" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <EditText
            android:id="@+id/editSenhaConfirmacao"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Confirme a senha"
            android:textColor="@android:color/black"
            android:textColorHint="#888888"
            android:background="@drawable/bg_edittext_selector"
            android:paddingHorizontal="12dp"
            android:textSize="16sp"
            android:inputType="textPassword" />
    </LinearLayout>

</LinearLayout>
