<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Ambiente de desenvolvimento: libera HTTP para hosts locais (10.0.2.2, 192.168.x.x). -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
