<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tema base -->
    <style name="Theme.AppCorrida" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="colorPrimary">@color/blue</item>
        <item name="colorSecondary">@color/gray</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSecondary">@android:color/black</item>
    </style>

    <!-- CHIP BASE -->
    <style name="ChipBase" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="chipCornerRadius">12dp</item>
        <item name="chipMinHeight">40dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
    </style>
    <style name="CustomChipStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_color_selector</item>
        <item name="android:textColor">@color/chip_text_selector</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/black</item>
    </style>

    <style name="ChipYellow" parent="ChipBase">
        <item name="chipBackgroundColor">@color/yellow</item>
    </style>

    <style name="ChipRed" parent="ChipBase">
        <item name="chipBackgroundColor">@color/red</item>
    </style>

    <style name="ChipGreen" parent="ChipBase">
        <item name="chipBackgroundColor">@color/green</item>
    </style>

    <style name="ChipBlue" parent="ChipBase">
        <item name="chipBackgroundColor">@color/blue</item>
    </style>

    <style name="ChipPurple" parent="ChipBase">
        <item name="chipBackgroundColor">@color/purple</item>
    </style>

    <style name="ChipOrange" parent="ChipBase">
        <item name="chipBackgroundColor">@color/orange</item>
    </style>
</resources>
