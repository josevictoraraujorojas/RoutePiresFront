<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/principal_passageiro_nav"
    app:startDestination="@id/selecionarLocalFragment">

    <action
        android:id="@+id/action_negociacaoFragment_to_chatFragment"
        app:destination="@id/chatFragment" />
    <fragment
        android:id="@+id/configuracaoPassageiroFragment"
        android:name="com.example.routepiresfront.ui.passageiro.ConfiguracaoPassageiroFragment"
        android:label="fragment_configuracao_passageiro"
        tools:layout="@layout/fragment_configuracao_passageiro" >
        <action
            android:id="@+id/action_configuracaoPassageiroFragment_to_editarPerfilFragment2"
            app:destination="@id/editarPerfilFragment2" />
        <action
            android:id="@+id/action_configuracaoPassageiroFragment_to_historicoCorridasFragment2"
            app:destination="@id/historicoCorridasFragment2" />
        <action
            android:id="@+id/action_configuracaoPassageiroFragment_to_notificacaoFragment2"
            app:destination="@id/notificacaoFragment2" />
    </fragment>
    <fragment
        android:id="@+id/editarPerfilFragment2"
        android:name="com.example.routepiresfront.ui.comum.EditarPerfilFragment"
        android:label="EditarPerfilFragment" />
    <fragment
        android:id="@+id/historicoCorridasFragment2"
        android:name="com.example.routepiresfront.ui.comum.HistoricoCorridasFragment"
        android:label="HistoricoCorridasFragment" />
    <fragment
        android:id="@+id/notificacaoFragment2"
        android:name="com.example.routepiresfront.ui.comum.NotificacaoFragment"
        android:label="NotificacaoFragment" />
    <fragment
        android:id="@+id/selecionarLocalFragment"
        android:name="com.example.routepiresfront.ui.passageiro.SelecionarLocalFragment"
        android:label="SelecionarLocalFragment" >
        <action
            android:id="@+id/action_selecionarLocalFragment_to_criacaoCorridaFragment"
            app:destination="@id/criacaoCorridaFragment" />
    </fragment>
    <fragment
        android:id="@+id/criacaoCorridaFragment"
        android:name="com.example.routepiresfront.ui.passageiro.CriacaoCorridaFragment"
        android:label="CriacaoCorridaFragment" >
        <action
            android:id="@+id/action_criacaoCorridaFragment_to_buscaMotoristaFragment"
            app:destination="@id/buscaMotoristaFragment" />
    </fragment>
    <fragment
        android:id="@+id/buscaMotoristaFragment"
        android:name="com.example.routepiresfront.ui.passageiro.BuscaMotoristaFragment"
        android:label="fragment_busca_motorista"
        tools:layout="@layout/fragment_busca_motorista" />
    <fragment
        android:id="@+id/avaliacaoFragment"
        android:name="com.example.routepiresfront.ui.comum.AvaliacaoFragment"
        android:label="AvaliacaoFragment" />
    <fragment
        android:id="@+id/negociacaoFragment2"
        android:name="com.example.routepiresfront.ui.comum.NegociacaoFragment"
        android:label="NegociacaoFragment" >
        <action
            android:id="@+id/action_negociacaoFragment2_to_chatFragment2"
            app:destination="@id/chatFragment2" />
    </fragment>
    <fragment
        android:id="@+id/chatFragment2"
        android:name="com.example.routepiresfront.chat.ChatFragment"
        android:label="ChatFragment" >
        <action
            android:id="@+id/action_chatFragment2_to_denunciaFragment2"
            app:destination="@id/denunciaFragment2" />
        <action
            android:id="@+id/action_chatFragment2_to_mototaxistaCaminhoFragment"
            app:destination="@id/mototaxistaCaminhoFragment" />
    </fragment>
    <fragment
        android:id="@+id/denunciaFragment2"
        android:name="com.example.routepiresfront.ui.comum.DenunciaFragment"
        android:label="DenunciaFragment" />
    <fragment
        android:id="@+id/mototaxistaCaminhoFragment"
        android:name="com.example.routepiresfront.ui.passageiro.MototaxistaCaminhoFragment"
        android:label="MototaxistaCaminhoFragment" />
</navigation>