<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/configuracap_motorista_nav"
    app:startDestination="@id/configuracaoMotoristaFragment">

    <fragment
        android:id="@+id/configuracaoMotoristaFragment"
        android:name="com.example.routepiresfront.UI.configuracao.ConfiguracaoMotoristaFragment"
        android:label="fragment_configuracao_motorista"
        tools:layout="@layout/fragment_configuracao_motorista" >
        <action
            android:id="@+id/action_configuracaoMotoristaFragment_to_editarPerfilFragment"
            app:destination="@id/editarPerfilFragment" />
        <action
            android:id="@+id/action_configuracaoMotoristaFragment_to_perfilVeiculoOuPlacaFragment"
            app:destination="@id/perfilVeiculoOuPlacaFragment" />
        <action
            android:id="@+id/action_configuracaoMotoristaFragment_to_historicoCorridasFragment"
            app:destination="@id/historicoCorridasFragment" />
        <action
            android:id="@+id/action_configuracaoMotoristaFragment_to_notificacaoFragment"
            app:destination="@id/notificacaoFragment" />
    </fragment>
    <fragment
        android:id="@+id/editarPerfilFragment"
        android:name="com.example.routepiresfront.UI.perfil.EditarPerfilFragment"
        android:label="EditarPerfilFragment" />
    <fragment
        android:id="@+id/perfilVeiculoOuPlacaFragment"
        android:name="com.example.routepiresfront.UI.perfil.PerfilVeiculoOuPlacaFragment"
        android:label="PerfilVeiculoOuPlacaFragment" />
    <fragment
        android:id="@+id/historicoCorridasFragment"
        android:name="com.example.routepiresfront.UI.corrida.HistoricoCorridasFragment"
        android:label="HistoricoCorridasFragment" />
    <fragment
        android:id="@+id/notificacaoFragment"
        android:name="com.example.routepiresfront.UI.notificacao.NotificacaoFragment"
        android:label="NotificacaoFragment" />
</navigation>